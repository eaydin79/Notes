<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".ChecklistNoteActivity">

    <Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:background="@drawable/toolbar_background"
        android:layout_height="?android:attr/actionBarSize">

        <TextView
            android:id="@+id/txtBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:contentDescription="@string/btn_back"
            android:clickable="true"
            android:background="?android:attr/selectableItemBackground"
            android:drawableStart="@drawable/ic_back" />
        <EditText
            android:id="@+id/editName"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAutofill="no"
            android:autofillHints=""
            android:maxLines="1"
            android:inputType="text"
            android:textStyle="normal"
            android:textColor="#FF161616"
            android:maxLength="128"
            android:layout_marginHorizontal="8sp"
            android:text="@string/new_list"
            tools:ignore="LabelFor" />

    </Toolbar>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:id="@+id/scrollItems"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:background="@color/white">
            <LinearLayout
                android:id="@+id/layout_items"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:animateLayoutChanges="true"
                android:paddingHorizontal="4dp"
                android:orientation="vertical" />
        </ScrollView>

        <LinearLayout
            android:id="@+id/layout_msg"
            android:visibility="visible"
            android:saveEnabled="false"
            android:background="@drawable/msg_background"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_margin="16dp"
            android:gravity="center"
            android:paddingVertical="16dp"
            android:paddingHorizontal="16dp">

            <TextView
                android:id="@+id/txtMsg"
                android:drawableStart="@drawable/ic_info"
                android:drawablePadding="8dp"
                android:contentDescription="@string/msg_import_item_limit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textSize="14sp"
                android:textColor="@color/black"
                android:text="@string/msg_import_item_limit" />

        </LinearLayout>

    </FrameLayout>



</LinearLayout>