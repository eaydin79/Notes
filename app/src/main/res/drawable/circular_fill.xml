<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Background track ring -->
    <item android:id="@android:id/background">
        <shape
            android:innerRadiusRatio="3"
            android:shape="ring"
            android:thicknessRatio="24"
            android:useLevel="false">
            <solid android:color="@color/icon" />
        </shape>
    </item>

    <!-- Foreground filling ring -->
    <item android:id="@android:id/progress">
        <rotate
            android:fromDegrees="270"
            android:toDegrees="270">
            <shape android:innerRadiusRatio="3"
                android:shape="ring"
                android:thicknessRatio="24"
                android:useLevel="true">
                <gradient
                    android:endColor="@color/warning"
                    android:startColor="@color/warning"
                    android:type="sweep" />
            </shape>
        </rotate>
    </item>

    <!-- Centered image asset -->
    <item
        android:drawable="@drawable/ic_action_delete"
        android:gravity="center"
        android:top="20dp"
        android:bottom="20dp"
        android:left="20dp"
        android:right="20dp" />

</layer-list>